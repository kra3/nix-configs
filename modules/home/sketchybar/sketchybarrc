#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Catppuccin Mocha + AeroSpace. Glassy bar; each widget group sits in its own
# darker translucent pill (bracket).

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Catppuccin Mocha palette ──────────────────────────────────────────────────
# base:    0xff1e1e2e   crust:   0xff11111b   surface1: 0xff313244
# text:    0xffcdd6f4   subtext: 0xffa6adc8   overlay:  0xff6c7086
# lavender:0xffb4befe   blue:    0xff89b4fa   pink:     0xfff5c2e7
# green:   0xffa6e3a1   yellow:  0xfff9e2af   red:      0xfff38ba8

# Group-pill style: darker crust glass so groups read below the bar glass.
PILL_BG=0xcc11111b
PILL_BORDER=0x22cdd6f4

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top          \
    height=36             \
    margin=8              \
    y_offset=4            \
    corner_radius=10      \
    blur_radius=45        \
    color=0xcc1e1e2e      \
    border_width=1        \
    border_color=0x22cdd6f4 \
    shadow=on             \
    topmost=window        \
    padding_left=10       \
    padding_right=10

# ── Global item defaults ──────────────────────────────────────────────────────
# Centralised popup look (bg + blur) so popups need no per-item styling.
sketchybar --default \
    updates=when_shown                          \
    padding_left=2                              \
    padding_right=2                             \
    icon.font="MesloLGS Nerd Font:Bold:15.0"     \
    label.font="MesloLGS Nerd Font:Bold:13.0"    \
    icon.color=0xffcdd6f4                       \
    label.color=0xffcdd6f4                      \
    icon.padding_left=3                         \
    icon.padding_right=4                        \
    label.padding_left=4                        \
    label.padding_right=3                       \
    popup.background.color=0xdd11111b           \
    popup.background.corner_radius=10           \
    popup.background.border_width=1             \
    popup.background.border_color=0x33cdd6f4    \
    popup.background.shadow.drawing=on          \
    popup.blur_radius=50

# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
# Number + window app-glyphs. Left-click focuses, ⌥-click moves the focused
# window (right-click isn't delivered to sketchybar here).
sketchybar --add event aerospace_workspace_change

COLOR=0xff89b4fa
for sid in $(seq 1 9); do
    sketchybar --add item space.$sid left \
        --set space.$sid \
            background.color=0x00000000              \
            background.corner_radius=6               \
            background.height=24                     \
            background.drawing=off                   \
            icon="$sid"                              \
            icon.font="Helvetica Neue:Bold:12.0"      \
            icon.color=$COLOR                        \
            icon.padding_left=7                      \
            icon.padding_right=4                     \
            label=""                                 \
            label.font="MesloLGS Nerd Font:Regular:14.0" \
            label.color=$COLOR                       \
            label.padding_right=7                    \
            padding_left=2                           \
            padding_right=2                          \
            click_script="case \$MODIFIER in *alt*) aerospace move-node-to-workspace $sid; sketchybar --trigger aerospace_workspace_change ;; *) aerospace workspace $sid ;; esac"
done

# Hidden single-pass updater; updates=on so it isn't paused while drawing=off.
sketchybar --add item spaces_ctl left \
    --set spaces_ctl drawing=off updates=on script="$PLUGIN_DIR/spaces.sh $COLOR" \
    --subscribe spaces_ctl aerospace_workspace_change front_app_switched display_change

sketchybar --add bracket workspaces '/space\.[0-9]/' \
    --set workspaces \
        background.color=$PILL_BG        \
        background.corner_radius=8       \
        background.height=26             \
        background.border_width=1        \
        background.border_color=$PILL_BORDER

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="MesloLGS Nerd Font:Bold:13.0"            \
        label.color=0xffa6adc8                              \
        padding_left=8                                      \
        padding_right=8                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

sketchybar --add bracket app front_app \
    --set app \
        background.color=$PILL_BG        \
        background.corner_radius=8       \
        background.height=26             \
        background.border_width=1        \
        background.border_color=$PILL_BORDER

# ── RIGHT ─────────────────────────────────────────────────────────────────────
# Add order is right-to-left; keep group members contiguous for clean pills.
# Layout (right → left):  [ clock ]  [ battery cpu mem ]  [ vol mic net ]

# Clock (rightmost) — popup shows month calendar + world clocks + today's agenda
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color=0xff89b4fa        \
        icon.padding_left=0          \
        label.color=0xffcdd6f4       \
        update_freq=30               \
        popup.align=right            \
        click_script="$PLUGIN_DIR/clock.sh toggle" \
        script="$PLUGIN_DIR/clock.sh" \
    --subscribe clock mouse.exited.global

# System group: battery, cpu, memory
sketchybar --add item battery right \
    --set battery \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                    \
        icon.color=0xffa6e3a1        \
        update_freq=30               \
        script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item memory right \
    --set memory \
        update_freq=30              \
        script="$PLUGIN_DIR/memory.sh"

# Media group: volume, mic, network
sketchybar --add item volume right \
    --set volume \
        click_script="$PLUGIN_DIR/volume.sh toggle" \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change mouse.exited.global mouse.scrolled

sketchybar --add slider volume.slider popup.volume 220 \
    --set volume.slider \
        slider.highlight_color=0xff89b4fa       \
        slider.background.height=6              \
        slider.background.corner_radius=3       \
        slider.background.color=0x33cdd6f4      \
        slider.knob="󰧟"                          \
        slider.knob.font="MesloLGS Nerd Font:Bold:16.0" \
        script="$PLUGIN_DIR/volume.sh slider"   \
    --subscribe volume.slider mouse.clicked

sketchybar --add item mic right \
    --set mic \
        label.drawing=off           \
        update_freq=15              \
        script="$PLUGIN_DIR/mic.sh"

sketchybar --add item network right \
    --set network \
        update_freq=30              \
        popup.align=center          \
        click_script="$PLUGIN_DIR/network.sh toggle" \
        script="$PLUGIN_DIR/network.sh" \
    --subscribe network mouse.exited.global

sketchybar --add bracket sys battery cpu memory \
    --set sys \
        background.color=$PILL_BG        \
        background.corner_radius=8       \
        background.height=26             \
        background.border_width=1        \
        background.border_color=$PILL_BORDER

sketchybar --add bracket media volume mic network \
    --set media \
        background.color=$PILL_BG        \
        background.corner_radius=8       \
        background.height=26             \
        background.border_width=1        \
        background.border_color=$PILL_BORDER

sketchybar --add bracket time clock \
    --set time \
        background.color=$PILL_BG        \
        background.corner_radius=8       \
        background.height=26             \
        background.border_width=1        \
        background.border_color=$PILL_BORDER

# ── Machine-local extras: downstream (work) drops sketchybar/local.sh ─────────
[ -f "$CONFIG_DIR/local.sh" ] && source "$CONFIG_DIR/local.sh"

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
