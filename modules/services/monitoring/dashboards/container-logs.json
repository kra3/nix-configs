{
  "title": "Container Logs",
  "uid": "container-logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["logs"],
  "templating": {
    "list": [
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "definition": "label_values({job=\"systemd-journal\", systemd_unit!~\"[0-9a-f]{64}-.*\"}, systemd_unit)",
        "query": "label_values({job=\"systemd-journal\", systemd_unit!~\"[0-9a-f]{64}-.*\"}, systemd_unit)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by unit",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (systemd_unit) (count_over_time({job=\"systemd-journal\", systemd_unit=~\"$unit\"} |~ \"(?i)$search\" [$__interval]))",
          "legendFormat": "{{systemd_unit}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 7 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"systemd-journal\", systemd_unit=~\"$unit\"} |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
