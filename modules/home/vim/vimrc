" Lean fallback config for root/servers; Neovim (LazyVim) is the daily editor.

let g:mapleader = "\<Space>"

set nocompatible
set encoding=utf-8
set hidden
set history=1000
set updatetime=300
set ttimeoutlen=50
set backspace=indent,eol,start
set mouse=a
set clipboard=unnamed
set autoread
set noswapfile
set undofile
set undodir=~/.vim/undo
silent! call mkdir(&undodir, 'p', 0700)

set number
set relativenumber
set cursorline
set scrolloff=5
set sidescrolloff=5
set nowrap
set splitbelow
set splitright
set wildmenu
set wildmode=longest:full,full
set showcmd
set laststatus=2
set signcolumn=yes

set ignorecase
set smartcase
set incsearch
set hlsearch

set expandtab
set shiftwidth=2
set tabstop=2
set softtabstop=2
set autoindent
set smartindent
set shiftround

syntax on
filetype plugin indent on
set background=dark
if has('termguicolors')
  set termguicolors
endif
silent! colorscheme habamax

set statusline=%<%f\ %h%m%r%=%y\ %{&fileencoding?&fileencoding:&encoding}\ %l:%c\ %P

noremap ; :
nnoremap <leader>w :w!<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>h :nohlsearch<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <leader>e :Explore<CR>
nnoremap <leader>b :ls<CR>:b<Space>
cmap w!! w !sudo tee % >/dev/null
vnoremap < <gv
vnoremap > >gv
nnoremap Y y$

autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g`\"" | endif
autocmd BufWritePre * %s/\s\+$//e
autocmd FileType make setlocal noexpandtab
autocmd FileType python setlocal shiftwidth=4 softtabstop=4 tabstop=4
