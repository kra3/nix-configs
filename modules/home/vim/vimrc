" Lean fallback config for root/servers; Neovim (LazyVim) is the daily editor.

let g:mapleader = "\<Space>"

set nocompatible
set encoding=utf-8
set hidden
set history=1000
set updatetime=300
set ttimeoutlen=50
set backspace=indent,eol,start
set mouse=a
set clipboard=unnamed
set autoread
set noswapfile
set undofile
set undodir=~/.vim/undo
silent! call mkdir(&undodir, 'p', 0700)

set number
set relativenumber
set cursorline
set scrolloff=5
set sidescrolloff=5
set nowrap
set splitbelow
set splitright
set wildmenu
set wildmode=longest:full,full
set showcmd
set laststatus=2
set signcolumn=yes

set ignorecase
set smartcase
set incsearch
set hlsearch

set expandtab
set shiftwidth=2
set tabstop=2
set softtabstop=2
set autoindent
set smartindent
set shiftround

syntax on
filetype plugin indent on
set background=dark
if has('termguicolors')
  set termguicolors
endif
silent! colorscheme habamax

set statusline=%<%f\ %h%m%r%=%y\ %{&fileencoding?&fileencoding:&encoding}\ %l:%c\ %P

silent !stty -ixon
if !has('gui_running')
  for k in ['j', 'k']
    exe "set <M-" . k . ">=\e" . k
  endfor
endif

nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <C-Up> <Cmd>resize +2<CR>
nnoremap <C-Down> <Cmd>resize -2<CR>
nnoremap <C-Left> <Cmd>vertical resize -2<CR>
nnoremap <C-Right> <Cmd>vertical resize +2<CR>
nnoremap <M-j> <Cmd>execute 'move .+' . v:count1<CR>==
nnoremap <M-k> <Cmd>execute 'move .-' . (v:count1 + 1)<CR>==
inoremap <M-j> <Esc><Cmd>m .+1<CR>==gi
inoremap <M-k> <Esc><Cmd>m .-2<CR>==gi
vnoremap <M-j> :<C-u>execute "'<,'>move '>+" . v:count1<CR>gv=gv
vnoremap <M-k> :<C-u>execute "'<,'>move '<-" . (v:count1 + 1)<CR>gv=gv

nnoremap <S-h> <Cmd>bprevious<CR>
nnoremap <S-l> <Cmd>bnext<CR>
nnoremap [b <Cmd>bprevious<CR>
nnoremap ]b <Cmd>bnext<CR>
nnoremap <leader>bb <Cmd>e #<CR>
nnoremap <leader>` <Cmd>e #<CR>
nnoremap <leader>bd <Cmd>bdelete<CR>
nnoremap <leader>fn <Cmd>enew<CR>

nnoremap <silent> <Esc> :nohlsearch<CR><Esc>
nnoremap <leader>ur <Cmd>nohlsearch<Bar>diffupdate<Bar>normal! <C-L><CR>
nnoremap <expr> n 'Nn'[v:searchforward] . 'zv'
xnoremap <expr> n 'Nn'[v:searchforward]
onoremap <expr> n 'Nn'[v:searchforward]
nnoremap <expr> N 'nN'[v:searchforward] . 'zv'
xnoremap <expr> N 'nN'[v:searchforward]
onoremap <expr> N 'nN'[v:searchforward]
inoremap , ,<C-g>u
inoremap . .<C-g>u
inoremap ; ;<C-g>u

nnoremap <C-s> <Cmd>w<CR><Esc>
inoremap <C-s> <Esc><Cmd>w<CR><Esc>
xnoremap <C-s> <Esc><Cmd>w<CR><Esc>
nnoremap <leader>qq <Cmd>qa<CR>
nnoremap <leader>K <Cmd>normal! K<CR>
vnoremap < <gv
vnoremap > >gv
nnoremap Y y$
nnoremap <leader>e <Cmd>Explore<CR>
cmap w!! w !sudo tee % >/dev/null

nnoremap <leader>xl <Cmd>if getloclist(0, {'winid': 0}).winid != 0 <Bar> lclose <Bar> else <Bar> lopen <Bar> endif<CR>
nnoremap <leader>xq <Cmd>if getqflist({'winid': 0}).winid != 0 <Bar> cclose <Bar> else <Bar> copen <Bar> endif<CR>
nnoremap [q <Cmd>cprevious<CR>
nnoremap ]q <Cmd>cnext<CR>

nnoremap <leader>- <C-w>s
nnoremap <leader>\| <C-w>v
nnoremap <leader>wd <C-w>c
nnoremap <leader><Tab>l <Cmd>tablast<CR>
nnoremap <leader><Tab>o <Cmd>tabonly<CR>
nnoremap <leader><Tab>f <Cmd>tabfirst<CR>
nnoremap <leader><Tab><Tab> <Cmd>tabnew<CR>
nnoremap <leader><Tab>] <Cmd>tabnext<CR>
nnoremap <leader><Tab>d <Cmd>tabclose<CR>
nnoremap <leader><Tab>[ <Cmd>tabprevious<CR>

autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g`\"" | endif
autocmd BufWritePre * %s/\s\+$//e
autocmd FileType make setlocal noexpandtab
autocmd FileType python setlocal shiftwidth=4 softtabstop=4 tabstop=4
